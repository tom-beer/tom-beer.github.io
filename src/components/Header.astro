---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

type Props = {
  backHref?: string;
  backLabel?: string;
};

const { backHref, backLabel } = Astro.props;

const NAV = [
  { href: "/blog", label: "Blog" },
  { href: "/publications", label: "Publications" },
];
---

<header>
  <Container>
    <div class="flex flex-wrap items-center gap-y-2 justify-between">
      <Link href="/" underline={false}>
        <div class="font-display text-lg font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      {backHref ? (
        <a
          href={backHref}
          class="group flex items-center gap-1.5 text-sm text-ink/60 dark:text-sand hover:text-ink dark:hover:text-cream transition-colors duration-300 ease-in-out">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="size-4 stroke-2 fill-none stroke-current -translate-x-0.5 group-hover:-translate-x-1 transition-transform duration-300 ease-in-out">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 5 12 12 19" />
          </svg>
          {backLabel}
        </a>
      ) : (
        <nav class="flex items-center gap-5 text-sm">
          {NAV.map(item => {
            const active = Astro.url.pathname.startsWith(item.href);
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "transition-colors duration-300 ease-in-out hover:text-ink dark:hover:text-cream",
                  active ? "text-ink dark:text-cream" : "text-ink/60 dark:text-sand",
                ]}>
                {item.label}
              </a>
            );
          })}
        </nav>
      )}
    </div>
  </Container>
</header>
