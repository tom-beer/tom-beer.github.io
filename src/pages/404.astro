---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<PageLayout title="Page not found" description="This page doesn't exist.">
  <Container framed>
    <div class="space-y-4">
      <h1 class="animate font-display text-3xl font-semibold text-ink dark:text-cream">
        Page not found
      </h1>
      <p class="animate">
        Nothing lives at this address. Try the <Link href="/">home page</Link>, the <Link href="/blog">blog</Link> or the <Link href="/publications">publications</Link>.
      </p>
    </div>
  </Container>
</PageLayout>
